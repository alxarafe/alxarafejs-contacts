{
	"name": "@alxarafe/contacts",
	"version": "0.1.0",
	"description": "Modulo de agenda: contactos, direcciones y canales de contacto",
	"type": "module",
	"license": "MIT",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
